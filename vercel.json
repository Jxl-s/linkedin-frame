{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p public && cp index.html public/ && cp -R js assets public/",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.py": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,assets/**}"
    },
    "api/discord.py": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,assets/**}"
    }
  }
}
